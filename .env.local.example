# ---- Vercel Postgres (Neon) ----
# Copy these four values verbatim from: Vercel Dashboard > Storage > your DB > .env.local tab
POSTGRES_PRISMA_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/verceldb?sslmode=require"

# ---- NextAuth ----
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ---- Email notifications (optional) ----
# Sign up free at https://resend.com, verify a sender, and paste your API key.
# Leave these blank and status-change emails are just skipped — nothing breaks.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CampusHiring <onboarding@resend.dev>"
