// Camoushiring — Prisma schema tuned for Vercel Postgres (Neon) serverless.
//
// POSTGRES_PRISMA_URL      -> pooled connection (PgBouncer). Used at runtime by
//                             every serverless function, so cold starts never
//                             exhaust the free-tier connection cap.
// POSTGRES_URL_NON_POOLING -> direct connection. Prisma needs this for
//                             `db push` / `migrate`, which cannot run over PgBouncer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Role {
  STUDENT
  COMPANY
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW_CONFIRMED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(STUDENT)
  companyName  String?
  headline     String?
  bio          String?
  skills       String?
  experience   String?
  hometown     String?
  openToWork   Boolean  @default(false)
  profileViews Int      @default(0)
  createdAt    DateTime @default(now())

  postedJobs   Job[]         @relation("PostedJobs")
  applications Application[]
  savedJobs    SavedJob[]
  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionReceiver")
  posts     Post[]
  postLikes PostLike[]
  comments  Comment[]

  @@index([role])
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  salary      String
  employment  String   @default("Full-time")
  createdAt   DateTime @default(now())

  companyId String
  company   User   @relation("PostedJobs", fields: [companyId], references: [id], onDelete: Cascade)

  applications Application[]
  savedBy      SavedJob[]

  @@index([companyId])
  @@index([location])
  @@index([createdAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // A student can bookmark a given job only once.
  @@unique([jobId, studentId])
  @@index([studentId])
}

model Application {
  id          String            @id @default(cuid())
  status      ApplicationStatus @default(APPLIED)
  cvUrl       String
  note        String?
  interviewAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // A student can apply to a given job exactly once.
  @@unique([jobId, studentId])
  @@index([studentId])
  @@index([status])
}

model Connection {
  id        String           @id @default(cuid())
  status    ConnectionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  requesterId String
  requester   User   @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // One request per direction — a mutual request is resolved by accepting
  // the existing row rather than creating a second one.
  @@unique([requesterId, receiverId])
  @@index([receiverId])
  @@index([requesterId])
}

// A post is a short update; give it a title and it reads as an article.
model Post {
  id        String   @id @default(cuid())
  title     String?
  content   String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes    PostLike[]
  comments Comment[]

  @@index([createdAt])
  @@index([authorId])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}
